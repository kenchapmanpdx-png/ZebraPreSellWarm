# === ZebraWell environment variables ===

# RESEND — required for waitlist + preorder email capture
# Get from: https://resend.com/api-keys
RESEND_API_KEY=

# Optional: tag waitlist + preorder contacts into separate Resend segments
# Leave unset to put all contacts in the default audience.
RESEND_WAITLIST_SEGMENT_ID=
RESEND_PREORDER_SEGMENT_ID=

# Optional: Neon Postgres for persisted backup of submissions
# Format: postgresql://user:pass@host/db?sslmode=require
# When unset, /api/* still works — submissions go to Resend + Vercel function logs.
DATABASE_URL=
